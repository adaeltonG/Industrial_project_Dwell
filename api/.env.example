# Local development only. Replace all example values for shared environments.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dwell:dwell@localhost:5432/dwell?schema=public
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
PUBLIC_SITE_URL=http://localhost:3000/dwell
ADMIN_EMAIL=admin@dwell.local
# Set a unique password of at least 12 characters before creating the first admin.
ADMIN_PASSWORD=
